<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same settings file, for both cloud backup and D2D transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="daily_light_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="daily_light_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
