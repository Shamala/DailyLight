<?xml version="1.0" encoding="utf-8"?>
<!--
  widgetCategory includes keyguard so the card is offered on the lock screen
  as well as the home screen. Modern Android allows every widget there unless
  it opts out with "not_keyguard"; naming keyguard explicitly also satisfies
  Samsung's older lock-screen picker.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:minResizeWidth="180dp"
    android:minResizeHeight="110dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="320dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_daily"
    android:previewLayout="@layout/widget_daily"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen|keyguard" />
