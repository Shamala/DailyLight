<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="52dp"
        android:paddingBottom="56dp">

        <!--
          The sky header. SkyHeaderView plays a three-second sunrise when the
          app opens in the morning voice, a sunset in the evening one, and
          the words fade in over it.
        -->
        <FrameLayout
            android:id="@+id/sky_header"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:background="@drawable/header_bg">

            <com.shamala.dailylight.SkyHeaderView
                android:id="@+id/sky_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/sky_words"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:id="@+id/tv_greeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:textSize="12sp"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true"
                    android:textColor="@color/cream_dim"
                    android:text="@string/greeting_morning" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="@font/lora_medium"
                    android:textSize="28sp"
                    android:textColor="@color/cream"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/tv_voice_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/lora_italic"
                    android:textSize="15sp"
                    android:textColor="@color/cream_dim"
                    android:text="@string/tagline" />
            </LinearLayout>
        </FrameLayout>

        <!-- Live preview of the card as it is right now -->
        <include
            layout="@layout/widget_daily"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp" />

        <!--
          Shown until the widget is on the home screen. One large button asks
          the launcher to place it; on a launcher that can't, the same space
          shows the three steps to do it by hand.
        -->
        <LinearLayout
            android:id="@+id/add_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="22dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_add_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/lora_regular"
                android:textSize="22sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/cream"
                android:text="@string/pin_title" />

            <TextView
                android:id="@+id/tv_add_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp"
                android:textColor="@color/cream_dim"
                android:text="@string/pin_body" />

            <LinearLayout
                android:id="@+id/steps_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/StepRow">
                    <TextView style="@style/StepNumber" android:text="1" tools:ignore="HardcodedText" />
                    <TextView style="@style/StepText" android:text="@string/step_1" />
                </LinearLayout>

                <LinearLayout style="@style/StepRow">
                    <TextView style="@style/StepNumber" android:text="2" tools:ignore="HardcodedText" />
                    <TextView style="@style/StepText" android:text="@string/step_2" />
                </LinearLayout>

                <LinearLayout style="@style/StepRow">
                    <TextView style="@style/StepNumber" android:text="3" tools:ignore="HardcodedText" />
                    <TextView style="@style/StepText" android:text="@string/step_3" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_pin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:minHeight="60dp"
                android:background="@drawable/btn_primary_bg"
                android:gravity="center"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text_dark"
                android:text="@string/pin_button" />

            <TextView
                android:id="@+id/btn_pin_later"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="@color/muted"
                android:text="@string/pin_later" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/btn_keep"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/btn_bg"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/cream_dim"
                android:text="@string/keep_this" />

            <TextView
                android:id="@+id/btn_another"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_bg"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/cream_dim"
                android:text="@string/another" />
        </LinearLayout>

        <TextView
            style="@style/Hint"
            android:layout_marginTop="10dp"
            android:layout_marginStart="4dp"
            android:text="@string/tap_hint" />

        <!-- ============ Your own words ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_your_words" />

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/Hint"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="12dp"
                android:text="@string/your_words_hint" />

            <EditText
                android:id="@+id/et_new_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_bg"
                android:padding="14dp"
                android:minLines="2"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:fontFamily="@font/lora_italic"
                android:textSize="15sp"
                android:textColor="@color/cream"
                android:textColorHint="@color/day_label"
                android:hint="@string/hint_new_word"
                android:importantForAutofill="no" />

            <TextView
                android:id="@+id/btn_add_word"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_accent_bg"
                android:paddingTop="13dp"
                android:paddingBottom="13dp"
                android:gravity="center"
                android:textSize="13sp"
                android:textColor="@color/accent"
                android:text="@string/add_to_pool" />

            <LinearLayout
                android:id="@+id/list_custom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ============ Kept ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_kept" />

        <LinearLayout style="@style/Card">

            <TextView
                android:id="@+id/tv_kept_hint"
                style="@style/Hint"
                android:text="@string/kept_hint" />

            <LinearLayout
                android:id="@+id/list_favourites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ============ Theme Settings ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_theme" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/sw_dark_mode"
                style="@style/Toggle"
                android:text="@string/dark_mode" />
        </LinearLayout>

        <!-- ============ The year line ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_year_line" />

        <LinearLayout style="@style/Card">

            <RadioGroup
                android:id="@+id/rg_year_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_day_of_year"
                    style="@style/Choice"
                    android:text="@string/yl_day_of_year" />

                <RadioButton
                    android:id="@+id/rb_days_lived"
                    style="@style/Choice"
                    android:text="@string/yl_days_lived" />

                <RadioButton
                    android:id="@+id/rb_bar_only"
                    style="@style/Choice"
                    android:text="@string/yl_bar_only" />

                <RadioButton
                    android:id="@+id/rb_countdown"
                    style="@style/Choice"
                    android:text="@string/yl_countdown" />
            </RadioGroup>

            <Switch
                android:id="@+id/sw_bar"
                style="@style/Toggle"
                android:text="@string/show_bar" />
        </LinearLayout>

        <!-- ============ Evening ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_evening" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/sw_evening"
                style="@style/Toggle"
                android:text="@string/evening_voice" />

            <TextView
                style="@style/Hint"
                android:text="@string/evening_hint" />

            <TextView
                android:id="@+id/tv_evening_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/lora_medium"
                android:textSize="15sp"
                android:textColor="@color/cream_dim"
                tools:text="from 18:00" />

            <SeekBar
                android:id="@+id/sb_evening_hour"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="11" />
        </LinearLayout>

        <!-- ============ Appearance ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_appearance" />

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/sw_shift"
                style="@style/Toggle"
                android:text="@string/shift_colours" />

            <TextView
                style="@style/Hint"
                android:text="@string/shift_hint" />

            <TextView
                style="@style/SubHeading"
                android:text="@string/text_size" />

            <RadioGroup
                android:id="@+id/rg_text_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_small"
                    style="@style/Choice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/size_small" />

                <RadioButton
                    android:id="@+id/rb_medium"
                    style="@style/Choice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/size_medium" />

                <RadioButton
                    android:id="@+id/rb_large"
                    style="@style/Choice"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/size_large" />
            </RadioGroup>
        </LinearLayout>

        <!-- ============ Placing it ============ -->

        <TextView
            style="@style/SectionHeading"
            android:text="@string/sec_placing" />

        <LinearLayout style="@style/Card">

            <!-- The same one-tap placing as the panel above, for after "Not now". -->
            <TextView
                android:id="@+id/btn_pin_again"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:minHeight="52dp"
                android:background="@drawable/btn_accent_bg"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="@color/accent"
                android:text="@string/pin_button"
                android:visibility="gone" />

            <TextView
                style="@style/Hint"
                android:text="@string/how_to_home" />

            <TextView
                style="@style/SubHeading"
                android:text="@string/lock_screen_title" />

            <TextView
                style="@style/Hint"
                android:text="@string/how_to_lock" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
