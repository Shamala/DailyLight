<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget face. Restricted to views RemoteViews can inflate — FrameLayout, LinearLayout,
  TextView, ImageView, ProgressBar. No ConstraintLayout, no bare View.

  Two tap zones: the header opens the app, the words reshuffle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="HardcodedText"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dawn">

    <!--
      The sky: sun, glow, horizon, or moon and stars. Painted by SkyPainter at
      a third of the card's size and stretched back up; it carries no words.
    -->
    <ImageView
        android:id="@+id/img_sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

<LinearLayout
    android:id="@+id/card_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header zone — tapping here opens the app -->
    <LinearLayout
        android:id="@+id/header_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tv_weekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textColor="@color/day_label"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="WEDNESDAY" />

            <!-- Inline Capsule & Text (When text is visible) -->
            <LinearLayout
                android:id="@+id/ll_year_inline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!--
                  Painted by CardRenderer.bar. A RemoteViews cannot swap a
                  progress drawable and cannot tint one below API 31, so the
                  bar used to be duplicated per theme; one image is the same
                  picture with the duplication gone. The src here is only what
                  the widget picker shows before the first real update.
                -->
                <ImageView
                    android:id="@+id/img_year_inline"
                    android:layout_width="28dp"
                    android:layout_height="5dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/bar_preview"
                    android:importantForAccessibility="no"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tv_yearline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="12sp"
                    android:letterSpacing="0.02"
                    android:textColor="@color/muted"
                    android:maxLines="1"
                    tools:text="Day 252 · 2026" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lora_medium"
            android:textSize="16sp"
            android:textColor="@color/cream_dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="17 September 2026" />

        <!--
          The same date, painted by us in Lora. The provider hides the text
          view above and shows this whenever the bitmap renders, so the
          launcher's system font can't override the typeface.
        -->
        <ImageView
            android:id="@+id/img_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <!-- Full-Width Divider (When Bar Only is selected) -->
        <ImageView
            android:id="@+id/fl_year_full"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:scaleType="fitXY"
            android:src="@drawable/bar_preview"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <!-- Subtle divider between header and affirmation -->
        <ImageView
            android:id="@+id/rule"
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/muted"
            android:alpha="0.3"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--
      Words zone — tapping here draws a different pairing.

      wrap_content plus weight 1: it measures at its natural height, then any
      space left over in the widget's cells is handed to it, and gravity
      centres the words inside that. So at a smaller text size the slack
      splits above and below the words instead of pooling at the bottom.
      When there is no slack it behaves exactly as wrap_content, so nothing
      gets squeezed on a short widget.
    -->
    <LinearLayout
        android:id="@+id/words_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        tools:ignore="InefficientWeight"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!--
          Affirmation and thought, painted in Lora as one image.

          fitCenter, not fitStart: the words are centred inside the bitmap, so
          whenever the launcher gives this view a different shape than the
          bitmap was painted for — a short widget that squeezes it, or a
          reported width that is off — the image has to shrink about the
          middle. fitStart pinned it to the left edge and pushed the whole
          block off-centre.
        -->
        <ImageView
            android:id="@+id/img_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_affirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/lora_italic"
            android:textSize="19sp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/cream"
            android:gravity="center_horizontal"
            android:maxLines="5"
            android:ellipsize="end"
            android:text="I begin again, and beginning again is not starting over." />

        <TextView
            android:id="@+id/tv_thought"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/lora_regular"
            android:textSize="12.5sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:gravity="center_horizontal"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Progress hides in the days that felt like nothing happened." />
    </LinearLayout>

</LinearLayout>

</FrameLayout>
