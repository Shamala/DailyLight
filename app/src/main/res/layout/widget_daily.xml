<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget face. Restricted to views RemoteViews can inflate — LinearLayout,
  TextView, ImageView, ProgressBar. No ConstraintLayout, no bare View.

  Two tap zones: the header opens the app, the words reshuffle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dawn"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header zone — tapping here opens the app -->
    <LinearLayout
        android:id="@+id/header_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/tv_weekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:textSize="10sp"
                android:letterSpacing="0.22"
                android:textColor="@color/day_label"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="WEDNESDAY" />

            <TextView
                android:id="@+id/tv_yearline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:textSize="10sp"
                android:letterSpacing="0.04"
                android:textColor="@color/muted"
                android:maxLines="1"
                android:text="Day 252 · 2026" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lora_medium"
            android:textSize="15sp"
            android:textColor="@color/cream_dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="9 September 2026" />

        <!-- How far along the year is. Doubles as the rule under the date. -->
        <ProgressBar
            android:id="@+id/pb_year"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progress="690"
            android:indeterminate="false"
            android:progressDrawable="@drawable/progress_year" />
    </LinearLayout>

    <!-- Words zone — tapping here draws a different pairing -->
    <LinearLayout
        android:id="@+id/words_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_affirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/lora_italic"
            android:textSize="19sp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/cream"
            android:maxLines="4"
            android:ellipsize="end"
            android:text="I begin again, and beginning again is not starting over." />

        <TextView
            android:id="@+id/tv_thought"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/lora_regular"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Progress hides in the days that felt like nothing happened." />
    </LinearLayout>

</LinearLayout>
