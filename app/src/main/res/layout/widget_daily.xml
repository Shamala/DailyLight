<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget face. Restricted to views RemoteViews can inflate — LinearLayout,
  TextView, ImageView, ProgressBar. No ConstraintLayout, no bare View.

  Two tap zones: the header opens the app, the words reshuffle.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dawn"
    android:paddingStart="22dp"
    android:paddingEnd="22dp"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <!-- Header zone — tapping here opens the app -->
    <LinearLayout
        android:id="@+id/header_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tv_weekday"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-light"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:textColor="@color/day_label"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="WEDNESDAY" />

            <!-- Inline Capsule & Text (When text is visible) -->
            <LinearLayout
                android:id="@+id/ll_year_inline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="5dp">

                    <ProgressBar
                        android:id="@+id/pb_year_inline"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="1000"
                        android:progress="690"
                        android:indeterminate="false"
                        android:progressDrawable="@drawable/progress_year" />

                    <ProgressBar
                        android:id="@+id/pb_year_light_inline"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="1000"
                        android:progress="690"
                        android:indeterminate="false"
                        android:visibility="gone"
                        android:progressDrawable="@drawable/progress_year_light" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_yearline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="10sp"
                    android:letterSpacing="0.02"
                    android:textColor="@color/muted"
                    android:maxLines="1"
                    xmlns:tools="http://schemas.android.com/tools"
                    tools:text="Day 252 · 2026" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lora_medium"
            android:textSize="16sp"
            android:textColor="@color/cream_dim"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="17 September 2026" />

        <!--
          The same date, painted by us in Lora. The provider hides the text
          view above and shows this whenever the bitmap renders, so the
          launcher's system font can't override the typeface.
        -->
        <ImageView
            android:id="@+id/img_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <!-- Full-Width Divider (When Bar Only is selected) -->
        <FrameLayout
            android:id="@+id/fl_year_full"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/pb_year_full"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progress="690"
                android:indeterminate="false"
                android:progressDrawable="@drawable/progress_year" />

            <ProgressBar
                android:id="@+id/pb_year_light_full"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:max="1000"
                android:progress="690"
                android:indeterminate="false"
                android:visibility="gone"
                android:progressDrawable="@drawable/progress_year_light" />
        </FrameLayout>

        <!-- Subtle divider between header and affirmation -->
        <ImageView
            android:id="@+id/rule"
            android:layout_width="32dp"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/muted"
            android:alpha="0.3"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />
    </LinearLayout>

    <!--
      Words zone — tapping here draws a different pairing.

      wrap_content plus weight 1: it measures at its natural height, then any
      space left over in the widget's cells is handed to it, and gravity
      centres the words inside that. So at a smaller text size the slack
      splits above and below the words instead of pooling at the bottom.
      When there is no slack it behaves exactly as wrap_content, so nothing
      gets squeezed on a short widget.
    -->
    <LinearLayout
        android:id="@+id/words_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Affirmation and thought, painted in Lora as one image. -->
        <ImageView
            android:id="@+id/img_words"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone"
            android:importantForAccessibility="no"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tv_affirmation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:fontFamily="@font/lora_italic"
            android:textSize="19sp"
            android:lineSpacingExtra="5dp"
            android:textColor="@color/cream"
            android:gravity="center_horizontal"
            android:maxLines="5"
            android:ellipsize="end"
            android:text="I begin again, and beginning again is not starting over." />

        <TextView
            android:id="@+id/tv_thought"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/lora_regular"
            android:textSize="12.5sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:gravity="center_horizontal"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Progress hides in the days that felt like nothing happened." />
    </LinearLayout>

</LinearLayout>
