<?xml version="1.0" encoding="utf-8"?>
<!-- Night background. Palette lives in values/colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/night_start"
                android:centerColor="@color/night_center"
                android:endColor="@color/night_end" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="180dp"
                android:centerX="0.14"
                android:centerY="0.08"
                android:startColor="@color/night_glow"
                android:endColor="@color/night_glow_end" />
        </shape>
    </item>

</layer-list>
