<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: night to plum, on the diagonal -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/bg_start"
                android:centerColor="@color/bg_center"
                android:endColor="@color/bg_end" />
        </shape>
    </item>

    <!-- First light, top right -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="230dp"
                android:centerX="0.9"
                android:centerY="0.05"
                android:startColor="@color/glow"
                android:endColor="@color/glow_end" />
        </shape>
    </item>

</layer-list>
