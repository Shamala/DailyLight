<?xml version="1.0" encoding="utf-8"?>
<!-- Dusk background. Palette lives in values/colors.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="@color/dusk_start"
                android:centerColor="@color/dusk_center"
                android:endColor="@color/dusk_end" />
        </shape>
    </item>

</layer-list>
